[Unit]
Description=Weinkuehlungssteuerung (Temperaturueberwachung + Relaissteuerung)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=urban
WorkingDirectory=/home/pi/kuehlungssteuerung
# Zugangsdaten (Token, ggf. SMTP-Passwort) aus einer nicht eingecheckten Datei laden.
# Das fuehrende "-" macht die Datei optional (Start schlaegt nicht fehl, wenn sie fehlt).
# Die Datei liegt ausserhalb des Repos, gelangt also nicht ins Git.
EnvironmentFile=-/etc/kuehlungssteuerung.env
ExecStart=/usr/bin/python3 /home/pi/kuehlungssteuerung/kuehlungssteuerung.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
